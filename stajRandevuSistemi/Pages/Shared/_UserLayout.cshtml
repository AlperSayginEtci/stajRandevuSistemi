@inherits Microsoft.AspNetCore.Mvc.Razor.RazorPage<dynamic>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Kullanıcı Paneli</title>

    
    <link id="bsTheme"
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --bs-primary: #0d6efd;
            --bs-primary-rgb: 13,110,253;
            --bs-btn-color-white: #fff;
        }

        .navbar-dark .btn,
        .navbar-dark .navbar-brand,
        .navbar-dark .nav-link {
            color: #fff !important;
        }


        .navbar-dark .navbar-brand,
        .navbar-dark .navbar-nav .nav-link {
            color: #fff !important;
        }
    </style>
</head>
<style>
   
    .navbar-dark {
        background-color: #2c3e50 !important;
    }

        .navbar-dark .navbar-brand,
        .navbar-dark .nav-link {
            color: #ffffff !important;
        }

        .navbar-dark .btn-outline-light {
            border-color: #ffffff;
            color: #ffffff;
        }
</style>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm mb-3">
        <div class="container-fluid">

            <!-- Ana Sayfa -->
            <a asp-page="/Index"
                class="btn btn-sm btn-outline-primary me-3 d-flex align-items-center"
               style="padding:.375rem .75rem;">
                <span class="me-1">🏠</span>Ana Sayfa
            </a>



          
            <span class="navbar-brand d-flex align-items-center pe-3">
                <span class="me-1">📚</span>
                Hoş geldiniz,
                <strong class="ms-1">
                    @User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value
                </strong>
            </span>

          
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navUser">
                <span class="navbar-toggler-icon"></span>
            </button>

           
            <div class="collapse navbar-collapse justify-content-end align-items-center" id="navUser">
                <div class="d-flex align-items-center">

                    <!-- Tema Seç -->
                    <select id="bootswatchSelector"
                            class="form-select form-select-sm me-3"
                            style="width:auto;">
                        <option value="default">Default</option>
                        <option value="cerulean">Cerulean</option>
                        <option value="cosmo">Cosmo</option>
                        <option value="darkly">Darkly</option>
                        <option value="superhero">Superhero</option>
                        
                    </select>

                    <!-- Hesabım -->
                    <a asp-page="/Account/Profile"
                       class="btn btn-sm btn-outline-primary me-3 d-flex align-items-center"
                       style="padding:.375rem .75rem;">
                        <span class="me-1">👤</span>Hesabım
                    </a>

                    <!-- Çıkış Yap -->
                    <form method="post" asp-page="/Account/Logout" class="d-flex">
                        <button type="submit"
                                class="btn btn-sm btn-outline-primary me-3 d-flex align-items-center"
                                style="padding:.375rem .75rem;">
                            <span class="me-1">🚪</span>Çıkış Yap
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <!-- Bootstrap JS  -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootswatch Tema  -->
    <script>
        const themeLink = document.getElementById("bsTheme");
        const selector  = document.getElementById("bootswatchSelector");
        const saved     = localStorage.getItem("bs-theme") || "default";

      
        selector.value = saved;
        applyTheme(saved);

    
        selector.addEventListener("change", () => {
          const t = selector.value;
          localStorage.setItem("bs-theme", t);
          applyTheme(t);
        });

        function applyTheme(name) {
          if (name === "default") {
            themeLink.href =
              "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css";
          } else {
            themeLink.href =
              `https://cdn.jsdelivr.net/npm/bootswatch@5/dist/${name}/bootstrap.min.css`;
          }
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>