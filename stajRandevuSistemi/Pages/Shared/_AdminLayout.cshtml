@inherits Microsoft.AspNetCore.Mvc.Razor.RazorPage<dynamic>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Admin Paneli</title>

    <link id="bsTheme"
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --bs-primary: #0d6efd;
            --bs-primary-rgb: 13,110,253;
            --bs-btn-color-white: #fff;
        }

        .navbar-dark .btn,
        .navbar-dark .navbar-brand,
        .navbar-dark .nav-link {
            color: #fff !important;
        }

        .navbar-dark {
            background-color: #2c3e50 !important;
        }

            .navbar-dark .btn-outline-light {
                border-color: #ffffff;
                color: #ffffff;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Admin/Yonetim">📚 Admin Paneli</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/Admin/Kutuphaneler">Kütüphaneler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Odalar/Sec">Odalar</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Kitaplar/Sec">📚 Kitap Yönetimi</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Kitaplar/Havuz">📦 Kitap Havuzu</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Kullanicilar/Kullanicilar">Kullanıcılar</a></li>
                </ul>

           
                <div class="d-flex align-items-center">
                    <!-- Tema Seç -->
                    <select id="bootswatchSelector"
                            class="form-select form-select-sm me-3"
                            style="width:auto;">
                        <option value="default">Default</option>
                        <option value="cerulean">Cerulean</option>
                        <option value="cosmo">Cosmo</option>
                        <option value="darkly">Darkly</option>
                        <option value="superhero">Superhero</option>
                    </select>
                    <a asp-page="/Admin/Profile" class="btn btn-sm btn-outline-light me-2">Hesabım</a>
                    <a asp-page="/Account/Logout" class="btn btn-sm btn-outline-light">Çıkış Yap</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const themeLink = document.getElementById("bsTheme");
        const selector = document.getElementById("bootswatchSelector");
        const saved = localStorage.getItem("bs-theme") || "default";

        selector.value = saved;
        applyTheme(saved);

        selector.addEventListener("change", () => {
            const selectedTheme = selector.value;
            localStorage.setItem("bs-theme", selectedTheme);
            applyTheme(selectedTheme);
        });

        function applyTheme(name) {
            if (name === "default") {
                themeLink.href = "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css";
            } else {
                themeLink.href = `https://cdn.jsdelivr.net/npm/bootswatch@5/dist/${name}/bootstrap.min.css`;
            }
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>