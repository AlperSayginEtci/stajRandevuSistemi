@page
@model KutuphaneOdaModel
@{
    ViewData["Title"] = "Oda Randevusu";
}

<h2>🏠 Oda Randevusu</h2>

<p><strong>Seçilen Kütüphane:</strong> @Model.KutuphaneAdi</p>

@if (Model.Odalar != null)
{
    <h4>Uygun Odalar</h4>
    @if (Model.Odalar.Any())
    {
        <ul class="list-group">
            @foreach (var oda in Model.Odalar)
            { 
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@oda.OdaNo</strong> – @oda.Kapasite kişilik
                    </div>
                    <a asp-page="/Randevu/RandevuOda/Al"
                       asp-route-OdaID="@oda.OdaID"
                       asp-route-KutuphaneID="@Model.KutuphaneID"
                       class="btn btn-sm btn-outline-primary">
                        📅 Randevu Al
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Bu kütüphaneye ait uygun oda bulunamadı.</p>
    }
}