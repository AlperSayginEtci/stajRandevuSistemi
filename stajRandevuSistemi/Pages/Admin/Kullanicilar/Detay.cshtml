@page "{id:int}"
@model DetayModel
@{
    ViewData["Title"] = "Kullanıcı Detayı";
    Layout = "_AdminLayout";
}

<h2>👤 @Model.Kullanici.Ad @Model.Kullanici.Soyad</h2>

<table class="table table-bordered w-50">
    <tr><th>Eposta</th><td>@Model.Kullanici.Eposta</td></tr>
    <tr><th>Kayıt Tarihi</th><td>@Model.Kullanici.KayitTarihi.ToShortDateString()</td></tr>
</table>

@if (!string.IsNullOrWhiteSpace(Model.HataMesaji))
{
    <div class="alert alert-danger">@Model.HataMesaji</div>
}

<h4 class="mt-4">🔐 Şifre Güncelle</h4>
<form method="post" asp-page-handler="SifreGuncelle">
    <input type="hidden" name="KullaniciID" value="@Model.Kullanici.KullaniciID" />
    <div class="mb-2">
        <input type="password" name="AdminSifresi" class="form-control" placeholder="Admin şifreniz" />
    </div>
    <div class="mb-2">
        <input type="password" name="YeniSifre" class="form-control" placeholder="Yeni şifre" />
    </div>
    <button type="submit" class="btn btn-warning">Şifreyi Güncelle</button>
</form>

<h4 class="mt-4 text-danger">⚠️ Kullanıcıyı Sil</h4>
<form method="post" asp-page-handler="Sil">
    <input type="hidden" name="KullaniciID" value="@Model.Kullanici.KullaniciID" />
    <input type="password" name="AdminSifresi" class="form-control mb-2" placeholder="Admin şifreniz" />
    <button type="submit" class="btn btn-danger">Sil</button>
</form>