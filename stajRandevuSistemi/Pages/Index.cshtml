@page
@model stajRandevuSistemi.Pages.IndexModel
@{
    Layout = "_UserLayout";
    
}



<h2>📚 Kütüphaneler</h2>

<!-- 1) Arama Barı-->
<input id="searchKutuphane"
       type="text"
       class="form-control mb-3"
       placeholder="Kütüphane ara..." />



@if (Model.Kutuphaneler.Any())
{
    <ul id="kutuphaneList" class="list-group">

        @foreach (var kutuphane in Model.Kutuphaneler)
        {
            <a asp-page="/Kutuphane/Sec"
               asp-route-id="@kutuphane.KutuphaneID"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center mb-2">
                <strong>@kutuphane.KutuphaneAdi</strong>
                
            </a>
        }
    </ul>
}
else
{
    <p>Henüz kayıtlı kütüphane bulunmamaktadır.</p>
}

<hr />

<div class="mt-4">
    <a class="btn btn-outline-secondary" asp-page="/Account/Profile">Hesabım</a>  
</div>
<form method="post" class="mt-4">
    <div class="mb-3">
        <label for="RandevuTuru" class="form-label">Randevu Türü:</label>
        <select asp-for="RandevuTuru" class="form-select">
            <option value="kitap">📚 Kitap Randevusu</option>
            <option value="oda">🏠 Oda Randevusu</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">📋 Randevularımı Gör</button>
</form>

@if (!string.IsNullOrEmpty(Model.HataMesaji))
{
    <div class="alert alert-danger mt-3">@Model.HataMesaji</div>
}  
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
          const input = document.getElementById("searchKutuphane");
          const list  = document.getElementById("kutuphaneList");
          if (!input || !list) return;

          const items = list.querySelectorAll(".list-group-item");
          input.addEventListener("input", function() {
            const term = this.value.trim().toLowerCase();
            items.forEach(item => {
              const text = item.textContent.trim().toLowerCase();
              item.classList.toggle("d-none", !text.includes(term));
            });
          });
        });
    </script>
}



