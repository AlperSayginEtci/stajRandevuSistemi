@page
@model OkunanKitaplarModel
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Okuduğum Kitaplar";
}

<div class="container">
    <h2 class="mb-4">📖 Okuduğunuz Kitaplar</h2>

    @if (Model.Kitaplar.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            @foreach (var kitap in Model.Kitaplar)
            {
                <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-3 shadow-sm">
                    <div>
                        <h6 class="mb-1 fw-bold">@kitap.KitapAdi</h6>
                        <p class="mb-1 text-muted">✍️ @kitap.Yazar</p>
                        <p class="mb-0 text-muted small">
                            📅 Alındı: @kitap.AlinmaTarihi.ToShortDateString() <br />
                            📅 Teslim: @kitap.TeslimTarihi.ToShortDateString()
                        </p>
                    </div>
                    <div style="width: 80px; height: 110px; overflow: hidden; border-radius: 4px;">
                        <img src="data:image/png;base64,@Convert.ToBase64String(kitap.KapakFoto)"
                             alt="@kitap.KitapAdi"
                             style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>Henüz kitap okunmamış.</p>
    }
</div>